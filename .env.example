# Copier ce fichier vers .env et renseigner les valeurs.
# .env n'est jamais versionné.

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True                         # True / False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost  # séparés par des virgules

# Base de données
# Deux moteurs possibles : garder un seul bloc actif, commenter l'autre.

# --- SQLite (par défaut) ---
# Aucune autre variable nécessaire : la base est le fichier db.sqlite3.
DB_ENGINE=sqlite

# --- PostgreSQL ---
# Pour l'utiliser : commenter le bloc SQLite ci-dessus et décommenter ce bloc.
# DB_ENGINE=postgres
# DB_NAME=norlys
# DB_USER=norlys
# DB_PASSWORD=changeme
# DB_HOST=127.0.0.1
# DB_PORT=5432
